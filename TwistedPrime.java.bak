class Prime
{
	public static boolean is Prime(int n)
	{
		int count=0;
		for(int i=0;i<=n;i++)
		{
			if(n%i==0)
			count++;
		}
		if(count==2)
			return true;
		else
			return false;
	}
}
class Reverse
{
	public static int reverse(int n)
	{
		int rev=0;
		while(n!=0)
		{
			int l=n%10;
			rev=rev*10+l;
			n=n/10;
		}
		return rev;
	}
}
class TwistedPrime
{
	public static void main(String[] args)
	{
		int n=13;
		boolean l=is prime(r);
		if(l==true)
